; Shared helpers for the benchmark programs. Run them all with
;   neptune bench            (use a release build: cargo build --release)
; which runs every benchmark in this folder uncapped (neptune run
; --uncapped) and writes docs/BENCHMARKS.md.

; Results go to the file named by NEPTUNE_BENCH_OUT, one per line:
;   group|name|value|unit
Function Report(group$, name$, value#, unit$)
    Print group + " / " + name + ": " + FormatFloat(value, 2) + " " + unit
    path$ = GetEnv("NEPTUNE_BENCH_OUT")
    If path = "" Then Return
    If FileSize(path) > 0
        f = OpenFile(path)
        SeekFile f, FileSize(path)
    Else
        f = WriteFile(path)
    EndIf
    WriteLine f, group + "|" + name + "|" + FormatFloat(value, 3) + "|" + unit
    CloseFile f
End Function

; Renders `frames` frames after `warmup` frames and returns the average
; frames per second. `spin` entities (if not 0) are turned every frame so
; the scene is not static.
Function MeasureFps#(frames, warmup)
    For i = 1 To warmup
        UpdateWorld
        RenderWorld
        Flip
    Next
    t0 = MilliSecs()
    For i = 1 To frames
        UpdateWorld
        RenderWorld
        Flip
    Next
    ms = MilliSecs() - t0
    If ms < 1 Then ms = 1
    Return frames * 1000.0 / ms
End Function

; A camera and a sun, the same in every 3D benchmark.
Function BenchScene(x#, y#, z#, lx#, ly#, lz#)
    cam = CreateCamera()
    CameraRange cam, 0.5, 3000
    CameraClsColor cam, 120, 160, 200
    PositionEntity cam, x, y, z
    LookAt cam, lx, ly, lz
    sun = CreateLight(1)
    RotateEntity sun, 50, 30, 0
    AmbientLight 90, 90, 100
    Return cam
End Function
