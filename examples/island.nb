; Island: a generated island with beaches and surf, pine and oak forests,
; eroded rocky slopes, a snowy peak, a clear sea and drifting clouds.
; Run from the repository root: neptune run examples/island.nb
; The camera circles the island. O lands you on the beach to walk:
; WASD move, mouse or arrows look, Shift run, F fly, O back to orbiting,
; 1-4 quality, Esc quit. Everything is made by the program: the island from
; noise worn down by simulated rain (ErodeTerrain), the textures from
; speckles, the trees from cones and spheres. The water is a custom shader
; (examples/media/water.shader).

Graphics3D 1280, 720
AppTitle "NeptuneBASIC - Island"
SeedRnd 2026

Const GRID = 256          ; terrain squares per side
Const CELL# = 3.2         ; metres per square: about 820 m across
Const TALL# = 160         ; highest possible ground, in metres
Const SEA# = 48           ; sea level

; ---- sky, light and haze: the sky's low band and the fog share one colour,
; so the sea melts into the sky with no horizon line
sky = CreateTexture(64, 64, 1 + 128)
For face = 0 To 5
    SetCubeFace sky, face
    SetBuffer TextureBuffer(sky)
    For y = 0 To 63
        ; overhead blue down to the fog colour, reached at the horizon
        t# = y / 31.5
        If t > 1 Then t = 1
        If face = 4 Then t = 0
        If face = 5 Then t = 1
        Color 128 + t * 68, 178 + t * 40, 222 + t * 14
        Rect 0, y, 64, 1
    Next
Next
SetBuffer BackBuffer()
SkyBox sky

cam = CreateCamera()
CameraRange cam, 0.3, 2200
CameraClsColor cam, 196, 218, 236
CameraFogMode cam, 1
CameraFogColor cam, 196, 218, 236
CameraFogRange cam, 300, 1400

sun = CreateLight(1)
RotateEntity sun, 42, 30, 0
LightColor sun, 255, 240, 214
LightShadows sun, True
AmbientLight 96, 104, 116
GraphicsQuality QUALITY_HIGH

; ---- the island's shape: a round coast broken up by noise, a peak in the middle
Dim noise#(3, 129, 129)
For o = 0 To 3
    For i = 0 To (8 Shl o) + 1
        For j = 0 To (8 Shl o) + 1
            noise(o, i, j) = Rnd(0, 1)
        Next
    Next
Next
; make every octave's lattice wrap, so textures made from it tile
For o = 0 To 3
    cells = 8 Shl o
    For i = 0 To cells
        noise(o, i, cells) = noise(o, i, 0)
        noise(o, cells, i) = noise(o, 0, i)
    Next
Next

; smooth value noise from octave o at u, v (0 to 1)
Function Octave#(o, u#, v#)
    cells = 8 Shl o
    ; outside 0 to 1 the pattern repeats
    u = u - Floor(u)
    v = v - Floor(v)
    x# = u * cells
    y# = v * cells
    i = Floor(x)
    j = Floor(y)
    fx# = x - i
    fy# = y - j
    fx = fx * fx * (3 - 2 * fx)
    fy = fy * fy * (3 - 2 * fy)
    a# = noise(o, i, j) + (noise(o, i + 1, j) - noise(o, i, j)) * fx
    b# = noise(o, i, j + 1) + (noise(o, i + 1, j + 1) - noise(o, i, j + 1)) * fx
    Return a + (b - a) * fy
End Function

Function SmoothStep#(lo#, hi#, x#)
    t# = (x - lo) / (hi - lo)
    If t < 0 Then t = 0
    If t > 1 Then t = 1
    Return t * t * (3 - 2 * t)
End Function

ground = CreateTerrain(GRID)
ScaleEntity ground, CELL, TALL, CELL
PositionEntity ground, -GRID * CELL / 2, 0, -GRID * CELL / 2
Dim hgt#(GRID, GRID)
For x = 0 To GRID
    For z = 0 To GRID
        u# = x / Float(GRID)
        v# = z / Float(GRID)
        n# = 0.45 * Octave(1, u, v) + 0.3 * Octave(2, u, v) + 0.25 * Octave(3, u, v)
        ; distance from the middle, pushed about by the noise for a ragged coast
        d# = Sqr((u - 0.5) ^ 2 + (v - 0.5) ^ 2) * 2 + (Octave(0, u, v) - 0.5) * 0.3
        land# = 1 - SmoothStep(0.55, 0.9, d)
        peak# = Exp(-((d / 0.32) ^ 2))
        metres# = land * (52 + 26 * n) + peak * (95 * (0.6 + 0.4 * n))
        h# = metres / TALL
        If h > 1 Then h = 1
        ModifyTerrain ground, x, z, h
    Next
Next
; wear the mountain down: rain carves gullies and ridges and carries soil
; down to the foot of the slopes, then the steepest slopes crumble a little
ErodeTerrain ground, 300000, 2026
ThermalErodeTerrain ground, 10, 50
For x = 0 To GRID
    For z = 0 To GRID
        hgt(x, z) = TerrainHeight(ground, x, z)
    Next
Next

; ---- textures, and painting by height and slope -----------------------
Function Speckles(r, g, b, spread)
    t = CreateTexture(64, 64)
    SetBuffer TextureBuffer(t)
    ClsColor r, g, b
    Cls
    For i = 1 To 700
        k = Rand(-spread, spread)
        Color r + k, g + k, b + k
        Rect Rand(0, 63), Rand(0, 63), Rand(1, 3), Rand(1, 3)
    Next
    SetBuffer BackBuffer()
    ScaleTexture t, 0.25, 0.25   ; four repeats per terrain square
    Return t
End Function

TerrainLayer ground, Speckles(96, 120, 56, 16), 0     ; grass
TerrainLayer ground, Speckles(138, 120, 98, 24), 1    ; rock
TerrainLayer ground, Speckles(214, 200, 160, 12), 2   ; sand
TerrainLayer ground, Speckles(242, 246, 250, 6), 3    ; snow, and surf at the waterline
For x = 0 To GRID
    For z = 0 To GRID
        metres# = hgt(x, z) * TALL
        x0 = x - 1 : If x0 < 0 Then x0 = 0
        x1 = x + 1 : If x1 > GRID Then x1 = GRID
        z0 = z - 1 : If z0 < 0 Then z0 = 0
        z1 = z + 1 : If z1 > GRID Then z1 = GRID
        ; rise over run
        slope# = Sqr((hgt(x1, z) - hgt(x0, z)) ^ 2 + (hgt(x, z1) - hgt(x, z0)) ^ 2) * TALL / (2 * CELL)
        rock# = SmoothStep(0.55, 0.95, slope)
        surf# = SmoothStep(SEA - 1.6, SEA - 0.4, metres) * (1 - SmoothStep(SEA + 0.1, SEA + 0.9, metres))
        ModifyTerrainLayer ground, x, z, 1, rock
        ModifyTerrainLayer ground, x, z, 2, 1 - SmoothStep(SEA + 1.5, SEA + 4, metres)
        ModifyTerrainLayer ground, x, z, 3, surf * 0.85 + SmoothStep(128, 140, metres) * (1 - rock * 0.5)
    Next
Next
TerrainDetail ground, 90000

; ---- the sea: the water shader on a grid over the island (every vertex
; knows the depth below it) and a ring around it out to the horizon
shader = LoadShader("examples/media/water.shader")
If shader = 0 Then RuntimeError "examples/media/water.shader is missing (run from the repository root)"
Const SEAGRID = 160
half# = GRID * CELL / 2
water = CreateMesh()
ss = CreateSurface(water)
For j = 0 To SEAGRID
    For i = 0 To SEAGRID
        wx# = -half + i * 2 * half / SEAGRID
        wz# = -half + j * 2 * half / SEAGRID
        v = AddVertex(ss, wx, SEA, wz)
        VertexData ss, v, 0, SEA - TerrainY(ground, wx, 0, wz), 0, 0
    Next
Next
For j = 0 To SEAGRID - 1
    For i = 0 To SEAGRID - 1
        a = j * (SEAGRID + 1) + i
        AddTriangle ss, a + SEAGRID + 1, a + SEAGRID + 2, a + 1
        AddTriangle ss, a + SEAGRID + 1, a + 1, a
    Next
Next

ocean = CreateMesh()
os = CreateSurface(ocean)
far# = 6000
; inner corners (the sea grid's edge), then outer corners
AddVertex os, -half, SEA, -half : AddVertex os, half, SEA, -half
AddVertex os, half, SEA, half : AddVertex os, -half, SEA, half
AddVertex os, -far, SEA, -far : AddVertex os, far, SEA, -far
AddVertex os, far, SEA, far : AddVertex os, -far, SEA, far
For k = 0 To 7
    VertexData os, k, 0, 60, 0, 0
Next
For k = 0 To 3
    n = (k + 1) Mod 4
    AddTriangle os, k, n, n + 4
    AddTriangle os, k, n + 4, k + 4
Next

; the sun's direction for the water's glints, in Fyrox space (X mirrored)
TFormVector 0, 0, 1, sun, 0
sunX# = TFormedX()
sunY# = -TFormedY()
sunZ# = -TFormedZ()
For k = 0 To 1
    If k = 0 Then w = water Else w = ocean
    EntityShader w, shader
    ShaderVector w, "sunDir", sunX, sunY, sunZ, 0
    ShaderVector w, "fogColor", 196 / 255.0, 218 / 255.0, 236 / 255.0, 1
    ShaderVector w, "fogRange", 300, 1400, 0, 0
    ShaderVector w, "skyColor", 0.70, 0.82, 0.93, 1
    ShaderVector w, "shallowColor", 0.14, 0.78, 0.78, 1
    ShaderVector w, "deepColor", 0.08, 0.26, 0.52, 1
    ShaderVector w, "bedColor", 0.84, 0.78, 0.6, 1
    ShaderVector w, "shape", 8, 1.0, 0.8, 0.2
    ShaderVector w, "clarity", 4, 0, 0, 0
Next

; ---- clouds: a high, drifting layer that fades into the haze
Function CloudTexture()
    t = CreateTexture(128, 128, 1 + 2)
    SetBuffer TextureBuffer(t)
    For y = 0 To 127
        For x = 0 To 127
            u# = x / 128.0
            v# = y / 128.0
            n# = 0.5 * Octave(0, u, v) + 0.28 * Octave(1, u, v) + 0.14 * Octave(2, u, v) + 0.08 * Octave(3, u, v)
            a# = SmoothStep(0.5, 0.7, n)
            shade = 236 + (n - 0.5) * 60
            If shade > 255 Then shade = 255
            WritePixel x, y, (Int(a * 235) Shl 24) Or (shade Shl 16) Or (shade Shl 8) Or 255
        Next
    Next
    SetBuffer BackBuffer()
    Return t
End Function
clouds = CreatePlane()
PositionEntity clouds, 0, 520, 0
cloudTex = CloudTexture()
ScaleTexture cloudTex, 900, 900
EntityTexture clouds, cloudTex
EntityFX clouds, 1 + 16      ; full bright, seen from below

; ---- trees: a few shapes built once as prefabs, planted many times -----
Function Pine(trunkH#, crownW#, layers, r, g, b)
    root = CreatePivot()
    trunk = CreateCylinder(5, True, root)
    ScaleEntity trunk, 0.22, trunkH / 2, 0.22
    PositionEntity trunk, 0, trunkH / 2, 0
    EntityColor trunk, 92, 64, 42
    For i = 0 To layers - 1
        c = CreateCone(7, True, root)
        w# = crownW * (1 - i * 0.24)
        ScaleEntity c, w, 2.0, w
        PositionEntity c, 0, trunkH + 1.4 + i * 1.9, 0
        EntityColor c, r + i * 6, g + i * 8, b + i * 4
    Next
    Return CreatePrefab(root)
End Function

Function Oak(trunkH#, crownW#, puffs, r, g, b)
    root = CreatePivot()
    trunk = CreateCylinder(5, True, root)
    ScaleEntity trunk, 0.3, trunkH / 2, 0.3
    PositionEntity trunk, 0, trunkH / 2, 0
    EntityColor trunk, 104, 76, 52
    For i = 0 To puffs - 1
        c = CreateSphere(6, root)
        ScaleEntity c, crownW, crownW * 0.8, crownW
        a# = i * 360.0 / puffs
        off# = 0 : If puffs > 1 Then off = crownW * 0.5
        PositionEntity c, Cos(a) * off, trunkH + crownW * 0.6 + (i Mod 2) * 0.6, Sin(a) * off
        EntityColor c, r + i * 5, g + i * 6, b
    Next
    Return CreatePrefab(root)
End Function

Dim kind(3)
kind(0) = Pine(2.4, 2.0, 2, 30, 86, 44)
kind(1) = Pine(3.0, 2.3, 3, 26, 78, 48)
kind(2) = Oak(2.6, 2.4, 1, 62, 112, 44)
kind(3) = Oak(2.4, 2.0, 3, 72, 118, 40)

; a palm frond: a drooping leaf with a ragged edge (as in examples/beach.nb)
frond = CreateMesh()
fs = CreateSurface(frond)
Const LEAF = 14
For i = 0 To LEAF
    t# = i / Float(LEAF)
    lz# = t * 4.4
    ly# = 1.2 * t - 2.7 * t * t
    lw# = 0.8 * Sin(t * 180) ^ 0.6
    If i Mod 2 = 1 Then lw = lw * 0.7
    AddVertex fs, 0, ly + 0.06, lz
    AddVertex fs, -lw, ly - 0.2 * lw, lz - 0.3 * lw
    AddVertex fs, lw, ly - 0.2 * lw, lz - 0.3 * lw
Next
For i = 0 To LEAF - 1
    a = i * 3
    AddTriangle fs, a, a + 3, a + 1
    AddTriangle fs, a + 1, a + 3, a + 4
    AddTriangle fs, a, a + 2, a + 3
    AddTriangle fs, a + 2, a + 5, a + 3
Next
UpdateNormals frond
EntityColor frond, 70, 146, 44
EntityFX frond, 16
HideEntity frond

Function Palm(frond, height#, lean#)
    root = CreatePivot()
    seg = root
    For i = 0 To 9
        piv = CreatePivot(seg)
        If i > 0 Then PositionEntity piv, 0, height / 10, 0
        TurnEntity piv, lean * (0.2 + i * 0.1), 0, 0
        cyl = CreateCylinder(7, True, piv)
        r# = 0.26 - i * 0.009
        ScaleEntity cyl, r, height / 20 + 0.04, r
        PositionEntity cyl, 0, height / 20, 0
        If i Mod 2 = 0 Then EntityColor cyl, 140, 108, 74 Else EntityColor cyl, 118, 90, 62
        seg = piv
    Next
    top = CreatePivot(seg)
    PositionEntity top, 0, height / 10, 0
    For k = 0 To 9
        f = CopyEntity(frond, top)
        ShowEntity f
        RotateEntity f, Rnd(-15, 20), k * 36 + Rnd(-10, 10), Rnd(-10, 10)
        s# = Rnd(0.85, 1.15)
        ScaleEntity f, s, s, s
    Next
    Return CreatePrefab(root)
End Function

; a tuft of grass blades
Function Tuft()
    m = CreateMesh()
    s = CreateSurface(m)
    For k = 0 To 8
        a# = Rnd(360)
        r# = Rnd(0, 0.15)
        bx# = Cos(a) * r
        bz# = Sin(a) * r
        h# = Rnd(0.35, 0.8)
        lean# = Rnd(0.05, 0.25)
        v = AddVertex(s, bx - 0.04 * Sin(a), 0, bz + 0.04 * Cos(a))
        AddVertex s, bx + 0.04 * Sin(a), 0, bz - 0.04 * Cos(a)
        AddVertex s, bx + Cos(a) * lean, h, bz + Sin(a) * lean
        AddTriangle s, v, v + 1, v + 2
    Next
    UpdateNormals m
    EntityColor m, 104, 136, 54
    EntityFX m, 16
    Return CreatePrefab(m)
End Function

Dim palmKind(2)
palmKind(0) = Palm(frond, 9, 4)
palmKind(1) = Palm(frond, 11, 6)
palmKind(2) = Palm(frond, 8, 9)
tuft = Tuft()

boulder = CreateSphere(4)
EntityColor boulder, 120, 112, 100
EntityFX boulder, 4            ; flat shading: a low-poly boulder
stone = CreatePrefab(boulder)

; everything planted goes under one mesh that is drawn in a few batches
; (EntityBatch), so thousands of copies stay fast
scenery = CreateMesh()

; forests where the forest noise is high (clearings elsewhere), on grass,
; below the snow; pines higher up, oaks lower down
Const SPACING# = 4.2
trees = 0
For gx# = -half To half Step SPACING
    For gz# = -half To half Step SPACING
        tx# = gx + Rnd(-2, 2)
        tz# = gz + Rnd(-2, 2)
        forest# = Octave(1, tx / (half * 2) + 0.5, tz / (half * 2) + 0.73)
        If forest > 0.46 + Rnd(0, 0.12)
            ty# = TerrainY(ground, tx, 0, tz)
            If ty > SEA + 4 And ty < 124 And TerrainLayerWeight(ground, 0, tx, tz) > 0.65
                If ty > 85 + Rnd(-20, 20) Then k = Rand(0, 1) Else k = Rand(0, 3)
                t = InstancePrefab(kind(k), scenery)
                PositionEntity t, tx, ty - 0.3, tz
                TurnEntity t, 0, Rnd(360), 0
                s# = Rnd(0.8, 1.35)
                ScaleEntity t, s, s * Rnd(0.85, 1.2), s
                trees = trees + 1
            EndIf
        EndIf
    Next
Next

; palms along the beaches, leaning out over the sand
palms = 0
For tries = 1 To 6000
    tx# = Rnd(-half, half)
    tz# = Rnd(-half, half)
    ty# = TerrainY(ground, tx, 0, tz)
    If ty > SEA + 1.5 And ty < SEA + 8 And TerrainLayerWeight(ground, 2, tx, tz) > 0.3 And palms < 160
        p = InstancePrefab(palmKind(Rand(0, 2)), scenery)
        PositionEntity p, tx, ty - 0.2, tz
        TurnEntity p, 0, Rnd(360), 0
        s# = Rnd(0.8, 1.2)
        ScaleEntity p, s, s, s
        palms = palms + 1
    EndIf
Next

; grass tufts over the meadows
For tries = 1 To 40000
    tx# = Rnd(-half, half)
    tz# = Rnd(-half, half)
    ty# = TerrainY(ground, tx, 0, tz)
    If ty > SEA + 3 And ty < 120 And TerrainLayerWeight(ground, 0, tx, tz) > 0.75
        p = InstancePrefab(tuft, scenery)
        PositionEntity p, tx, ty, tz
        TurnEntity p, 0, Rnd(360), 0
        s# = Rnd(0.9, 1.8)
        ScaleEntity p, s, s, s
    EndIf
Next

; boulders on the rocky slopes and along the shore, with pebbles
For i = 1 To 400
    tx# = Rnd(-half, half)
    tz# = Rnd(-half, half)
    ty# = TerrainY(ground, tx, 0, tz)
    shore = ty > SEA - 1 And ty < SEA + 1.5
    If ty > SEA - 1 And (TerrainLayerWeight(ground, 1, tx, tz) > 0.3 Or shore)
        r = InstancePrefab(stone, scenery)
        PositionEntity r, tx, ty, tz
        RotateEntity r, Rnd(-20, 20), Rnd(360), Rnd(-20, 20)
        bs# = Rnd(0.8, 3)
        ScaleEntity r, 1.2 * bs, 0.6 * bs, 0.9 * bs
        For k = 1 To 6
            px# = tx + Rnd(-4, 4)
            pz# = tz + Rnd(-4, 4)
            r = InstancePrefab(stone, scenery)
            PositionEntity r, px, TerrainY(ground, px, 0, pz), pz
            ScaleEntity r, Rnd(0.1, 0.2), Rnd(0.06, 0.1), Rnd(0.08, 0.16)
        Next
    EndIf
Next
EntityBatch scenery, 1

; ---- where walking starts: on the south beach --------------------------
sx# = 0
sz# = -half
While sz < half And TerrainY(ground, sx, 0, sz) < SEA + 0.8
    sz = sz + 2
Wend
sz = sz + 4
; face along the beach: the direction whose ground 40 m ahead is nearest beach height
startYaw# = 0
best# = 1000
For a = 0 To 345 Step 15
    ahead# = TerrainY(ground, sx - Sin(a) * 40, 0, sz + Cos(a) * 40)
    If ahead > SEA And Abs(ahead - (SEA + 3)) < best
        best = Abs(ahead - (SEA + 3))
        startYaw = a
    EndIf
Next

orbit = 1
fly = 0
angle# = 200
yaw# = 0
pitch# = 0
frames = 0
fps# = 60
prev = MilliSecs()
While True
    frames = frames + 1
    now = MilliSecs()
    dt# = (now - prev) / 1000.0
    prev = now
    If dt > 0.1 Then dt = 0.1
    If dt > 0 Then fps = fps * 0.95 + (1 / dt) * 0.05

    If KeyHit(KEY_O)
        orbit = 1 - orbit
        If orbit = 0
            ; land on the beach, looking inland
            PositionEntity cam, sx, TerrainY(ground, sx, 0, sz) + 1.75, sz
            yaw = startYaw : pitch = 0 : fly = 0
            HidePointer
            MoveMouse 640, 360
            MouseXSpeed() : MouseYSpeed()
        Else
            ShowPointer
        EndIf
    EndIf
    If KeyHit(KEY_1) Then GraphicsQuality QUALITY_LOW
    If KeyHit(KEY_2) Then GraphicsQuality QUALITY_MEDIUM
    If KeyHit(KEY_3) Then GraphicsQuality QUALITY_HIGH
    If KeyHit(KEY_4) Then GraphicsQuality QUALITY_ULTRA

    If orbit
        ; circle the island
        angle = angle + 9 * dt
        PositionEntity cam, Sin(angle) * 520, 210, Cos(angle) * 520
        LookAt cam, 0, 40, 0
    Else
        ; look
        yaw = yaw - MouseXSpeed() * 0.14
        pitch = pitch + MouseYSpeed() * 0.14
        yaw = yaw + (KeyDown(KEY_LEFT) - KeyDown(KEY_RIGHT)) * 80 * dt
        pitch = pitch + (KeyDown(KEY_DOWN) - KeyDown(KEY_UP)) * 50 * dt
        If pitch > 80 Then pitch = 80
        If pitch < -80 Then pitch = -80
        RotateEntity cam, pitch, yaw, 0
        MoveMouse 640, 360
        If KeyHit(KEY_F) Then fly = 1 - fly

        ; move: walking keeps level, flying goes where you look
        spd# = 6
        If KeyDown(KEY_LSHIFT) Then spd = 18
        If fly Then spd = spd * 4
        spd = spd * dt
        fwd# = (KeyDown(KEY_W) - KeyDown(KEY_S)) * spd
        side# = (KeyDown(KEY_D) - KeyDown(KEY_A)) * spd
        If fly
            MoveEntity cam, side, 0, fwd
        Else
            TurnEntity cam, -pitch, 0, 0
            MoveEntity cam, side, 0, fwd
            TurnEntity cam, pitch, 0, 0
        EndIf

        ; stay on the land or the water, whichever is higher, and near the island
        px# = EntityX(cam)
        pz# = EntityZ(cam)
        If px < -half Then px = -half
        If px > half Then px = half
        If pz < -half Then pz = -half
        If pz > half Then pz = half
        h# = TerrainY(ground, px, 0, pz)
        If h < SEA Then h = SEA
        py# = EntityY(cam)
        If fly = 0 Then py = h + 1.75
        If fly = 1 And py < h + 2 Then py = h + 2
        PositionEntity cam, px, py, pz
    EndIf

    ; the water moves, the clouds drift
    ShaderFloat water, "time", now / 1000.0
    ShaderFloat ocean, "time", now / 1000.0
    PositionTexture cloudTex, now / 500000.0, now / 1100000.0

    RenderWorld
    Color 255, 250, 236
    If orbit
        Text 12, 12, "O: land and walk   1-4 quality   Esc quit"
    Else
        mode$ = "walk"
        If fly Then mode$ = "fly"
        Text 12, 12, "WASD move   Shift run   F fly / walk   O orbit   1-4 quality   Esc quit"
        Text 12, 52, $"{mode$}   height {Int(EntityY(cam) - SEA)} m"
    EndIf
    Text 12, 32, $"fps {Int(fps)}   {trees} trees   {palms} palms"
    Flip
    If frames > 8 And KeyHit(KEY_ESCAPE) Then End
Wend
