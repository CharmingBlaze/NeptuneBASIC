LinePick|LoadFont|LoadMesh|MouseHit|NavMeshX|NavMeshY|NavMeshZ|NetMsgTo|NextFile|OpenFile|PathCost|PeekByte|PickedNX|PickedNY|PickedNZ|PokeByte|ReadByte|ReadFile|ReadLine|ScanLine|SeekFile|SetColor|SetGamma|SetScene|SoundPan|TFormedX|TFormedY|TFormedZ|TerrainX|TerrainY|TerrainZ|TrackKey|UDPMsgIP|UIButton|UISlider|VertexNX|VertexNY|VertexNZ|Viewport|WriteInt|AddInts|AddMesh|AnimSeq|Animate|Average|Body2DX|Body2DY|BrushFX|CallDLL|EntityX|EntityY|EntityZ|FilePos|FitMesh|FreeGui|GetTile|GuiCell|GuiDock|GuiGrid|GuiList|GuiMenu|GuiTabs|GuiText|GuiTree|JoyDown|JoyRoll|JoyType|JoyUDir|JoyVDir|JoyWait|JoyXDir|JoyYDir|JoyZDir|KeyDown|PeekInt|PickedX|PickedY|PickedZ|PokeInt|ReadDir|ReadInt|Replace|RndSeed|SeedRnd|SetFont|SetTile|UIHover|UILabel|UIPanel|UITheme|VertexU|VertexV|VertexW|VertexX|VertexY|VertexZ|WBuffer|WaitJoy|WaitKey|Dither|GetEnv|GetJoy|GetKey|GuiTab|HostIP|JoyHat|JoyHit|JoyYaw|KeyHit|Locate|LookAt|MouseX|MouseY|MouseZ|Origin|SetEnv|SkyBox|String|TileAt|TypeOf|ATan2|Clamp|Color|Delay|Floor|Greet|Input|Instr|Log10|Lower|PathX|PathY|PathZ|Print|Right|Upper|VWait|Write|ACos|ASin|ATan|Ceil|Flip|JoyU|JoyV|JoyX|JoyY|JoyZ|LSet|Left|Lerp|Line|Oval|Plot|RSet|Rand|Rect|Text|Trim|Asc|Bin|Chr|Cls|Cos|Eof|Exp|Fib|Hex|Len|Log|Max|Mid|Min|Rnd|Sin|Sqr|Tan)\\b"
    },
    {
      "name": "constant.other.neptune",
      "match": "\\b[A-Z][A-Z0-9_]*_[A-Z0-9_]+\\b"
    },
    {
      "name": "keyword.operator.neptune",
      "match": "\\+=|-=|\\*=|/=|<>|<=|>=|[-+*/^=<>\\]"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.neptune",
          "match": ";.*$"
        },
        {
          "name": "comment.line.quote.neptune",
          "match": "'.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.neptune",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.neptune",
              "match": "\"\"|\\{\\{|\\}\\}"
            },
            {
              "name": "meta.embedded.neptune",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.neptune",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.neptune",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.neptune",
          "match": "\\$[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.binary.neptune",
          "match": "%[01]+\\b"
        },
        {
          "name": "constant.numeric.neptune",
          "match": "\\b[0-9]+(\\.[0-9]*)?([eE][-+]?[0-9]+)?\\b|\\.[0-9]+\\b"
        }
      ]
    }
  }
}