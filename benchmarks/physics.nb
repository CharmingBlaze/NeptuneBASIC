; Physics (Rapier through Fyrox) and Blitz-style collisions.
Include "bench.nb"
Graphics3D 1280, 720
cam = BenchScene(0, 40, -70, 0, 5, 0)

ground = CreateCube()
ScaleEntity ground, 60, 1, 60
PositionEntity ground, 0, -1, 0
EntityPhysics ground, 2, 1

; rigid bodies dropped in a heap: everything is moving and touching
Data 250, 500, 1000, 2000
For stage = 1 To 4
    Read n
    Dim boxes(n)
    side = Ceil(Sqr(n / 4.0))
    For i = 0 To n - 1
        b = CreateCube()
        ScaleEntity b, 0.5, 0.5, 0.5
        PositionEntity b, (i Mod side) * 1.3 - side * 0.65 + Rnd(-0.1, 0.1), 2 + (i / (side * side)) * 1.3, ((i / side) Mod side) * 1.3 - side * 0.65
        EntityPhysics b, 1, 1, 1
        boxes(i) = b
    Next
    Report "physics", $"{n} falling, stacking boxes", MeasureFps(300, 10), "fps"
    For i = 0 To n - 1
        FreeEntity boxes(i)
    Next
Next
FreeEntity ground

; Blitz3D collisions: spheres sliding over a level made of boxes
level = CreatePivot()
For i = 0 To 40
    w = CreateCube(level)
    ScaleEntity w, Rnd(1, 4), Rnd(1, 3), Rnd(1, 4)
    PositionEntity w, Rnd(-40, 40), 0, Rnd(-40, 40)
    EntityType w, 2
Next
floorBox = CreateCube(level)
ScaleEntity floorBox, 60, 1, 60
PositionEntity floorBox, 0, -2, 0
EntityType floorBox, 2
Collisions 1, 2, 2, 2
Data 100, 300, 1000
For stage = 1 To 3
    Read n
    Dim balls(n)
    For i = 0 To n - 1
        b = CreateSphere(8)
        PositionEntity b, Rnd(-40, 40), 1, Rnd(-40, 40)
        TurnEntity b, 0, Rnd(360), 0
        EntityType b, 1
        EntityRadius b, 0.5
        balls(i) = b
    Next
    t = MilliSecs()
    For f = 1 To 200
        For i = 0 To n - 1
            MoveEntity balls(i), 0, -0.05, 0.2
        Next
        UpdateWorld
        RenderWorld
        Flip
    Next
    Report "physics", $"{n} spheres sliding (Blitz collisions)", 200000.0 / Max(1, MilliSecs() - t), "fps"
    For i = 0 To n - 1
        FreeEntity balls(i)
    Next
Next
End
