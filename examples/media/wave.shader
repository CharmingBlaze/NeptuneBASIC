// A custom NeptuneBASIC shader (Fyrox shader format: GLSL inside a RON
// description). Used by examples/rendering.nb:
//   shader = LoadShader("examples/media/wave.shader")
//   EntityShader mesh, shader
//   ShaderFloat mesh, "time", MilliSecs() / 1000.0
//   ShaderVector mesh, "tint", 1, 0.6, 0.2, 1
// Every vertex carries VertexData slot 0 = (phase, height, colour mix, 0),
// read here at location 8.
(
    name: "WaveShader",

    resources: [
        (
            name: "diffuseTexture",
            kind: Texture(kind: Sampler2D, fallback: White),
            binding: 0
        ),
        (
            name: "properties",
            kind: PropertyGroup([
                (
                    name: "time",
                    kind: Float(value: 0.0),
                ),
                (
                    name: "tint",
                    kind: Vector4(value: (1.0, 1.0, 1.0, 1.0)),
                ),
            ]),
            binding: 0
        ),
        (
            name: "fyrox_instanceData",
            kind: PropertyGroup([
                // Autogenerated
            ]),
            binding: 1
        ),
    ],

    disabled_passes: ["GBuffer", "DirectionalShadow", "PointShadow", "SpotShadow"],

    passes: [
        (
            name: "Forward",
            draw_parameters: DrawParameters(
                cull_face: None,
                color_write: ColorMask(
                    red: true,
                    green: true,
                    blue: true,
                    alpha: true,
                ),
                depth_write: true,
                stencil_test: None,
                depth_test: Some(Less),
                blend: None,
                stencil_op: StencilOp(
                    fail: Keep,
                    zfail: Keep,
                    zpass: Keep,
                    write_mask: 0xFFFF_FFFF,
                ),
                scissor_box: None
            ),
            vertex_shader:
               r#"
                layout(location = 0) in vec3 vertexPosition;
                layout(location = 1) in vec2 vertexTexCoord;
                layout(location = 8) in vec4 waveData;

                out vec2 texCoord;
                out float colourMix;

                void main()
                {
                    texCoord = vertexTexCoord;
                    colourMix = waveData.z;
                    vec3 p = vertexPosition;
                    p.y += sin(properties.time * 3.0 + waveData.x) * waveData.y;
                    gl_Position = fyrox_instanceData.worldViewProjection * vec4(p, 1.0);
                }
               "#,

           fragment_shader:
               r#"
                in vec2 texCoord;
                in float colourMix;

                out vec4 FragColor;

                void main()
                {
                    vec4 base = S_SRGBToLinear(texture(diffuseTexture, texCoord));
                    vec3 deep = vec3(0.02, 0.08, 0.25);
                    FragColor = vec4(mix(deep, properties.tint.rgb, colourMix) * base.rgb, 1.0);
                }
               "#,
        )
    ],
)
