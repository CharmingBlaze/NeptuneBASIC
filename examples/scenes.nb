; Background loading and saved scenes (ext). Run from the project folder:
;   neptune run examples/scenes.nb
; A loading screen shows progress while two animated models and a texture
; load in the background. Then: S saves the scene, C clears it, L loads
; the saved file back (models are loaded again from their files), Esc quits.

Graphics3D 800, 600, 0, 2
AppTitle "Background loading and saved scenes"

Const LEVEL_FILE$ = "examples/saved_level.rgs"

Function MakeCameraAndLight()
    cam = CreateCamera()
    PositionEntity cam, 0, 3, -9
    RotateEntity cam, 12, 0, 0
    light = CreateLight()
    RotateEntity light, 45, 30, 0
    AmbientLight 90, 90, 100
End Function

MakeCameraAndLight()

; ---- start everything loading, then show progress until it is done
fox = LoadMeshAsync("examples/media/Fox.glb")
man = LoadMeshAsync("examples/media/CesiumMan.glb")
grass = LoadTextureAsync("examples/media/checker.png")
; entities can be placed while their models are still loading
PositionEntity fox, -2.5, 0, 0
ScaleEntity fox, 0.03, 0.03, 0.03
PositionEntity man, 2.5, 0, 0
ScaleEntity man, 1.8, 1.8, 1.8
TurnEntity man, 0, 180, 0

total = PendingLoads()
While PendingLoads() > 0
    done# = total - PendingLoads()
    Cls
    Color 255, 255, 255
    Text GraphicsWidth() / 2, 260, "Loading...", True
    Color 60, 60, 80 : Rect 200, 290, 400, 24
    Color 90, 200, 120 : Rect 200, 290, 400 * done / total, 24
    Flip
Wend
If EntityLoaded(fox) <> 1 Or EntityLoaded(man) <> 1 Then RuntimeError "Could not load the models"

ground = CreatePlane()
EntityTexture ground, grass
ScaleTexture grass, 4, 4
NameEntity ground, "ground"
For i = 1 To 5
    block = CreateCube()
    PositionEntity block, -6 + i * 2, 0.5, 4
    EntityColor block, 60 + i * 35, 120, 255 - i * 35
    NameEntity block, "block" + i
Next
NameEntity fox, "fox"
NameEntity man, "man"
Animate fox, 1, 1, 2
Animate man

message$ = "S: save   C: clear   L: load   Esc: quit"
While Not KeyHit(1)
    If KeyHit(31)
        If SaveScene(LEVEL_FILE) Then message = "Saved to " + LEVEL_FILE Else message = "Could not save"
    EndIf
    If KeyHit(46)
        ClearWorld
        MakeCameraAndLight()
        message = "Cleared - press L to load the saved scene"
    EndIf
    If KeyHit(38)
        ClearWorld
        MakeCameraAndLight()
        level = LoadScene(LEVEL_FILE)
        If level
            ; named entities are found again with FindChild, and models can be animated
            Animate FindChild(level, "fox"), 1, 1, 2
            Animate FindChild(level, "man")
            message = "Loaded " + LEVEL_FILE
        Else
            message = "Nothing saved yet"
        EndIf
    EndIf
    UpdateWorld
    RenderWorld
    Color 255, 255, 255
    Text 10, 10, message
    Flip
Wend
End
