{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NeptuneBASIC",
  "scopeName": "source.neptune",
  "fileTypes": [
    "nb",
    "bb"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "name": "keyword.control.neptune",
      "match": "(?i)\\b(end\\s+(if|function|type|select|try|method|enum)|else\\s+if)\\b"
    },
    {
      "name": "keyword.control.neptune",
      "match": "(?i)\\b(EndFunction|EndMethod|EndSelect|Continue|Function|Classic|Default|EndEnum|EndType|Forever|Include|Restore|Before|Delete|ElseIf|EndTry|Global|Import|Insert|Method|Repeat|Return|Select|Strict|After|Catch|Const|EndIf|Field|First|Gosub|Local|Throw|Until|While|Case|Data|Each|Else|Enum|Exit|Goto|Last|Next|Read|Step|Stop|Then|Type|Wend|Dim|End|For|New|Try|As|If|In|To)\\b"
    },
    {
      "name": "keyword.operator.word.neptune",
      "match": "(?i)\\b(AndAlso|OrElse|And|Mod|Not|Sar|Shl|Shr|Xor|Or)\\b"
    },
    {
      "name": "constant.language.neptune",
      "match": "(?i)\\b(False|Null|Self|True|Pi)\\b"
    },
    {
      "name": "storage.type.neptune",
      "match": "(?i)\\b(Boolean|Integer|Variant|Handle|Object|Single|String|Float|Bool|Abs|Any|Int|Sgn|Str)\\b"
    },
    {
      "name": "entity.name.label.neptune",
      "match": "^\\s*\\.[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "support.function.neptune",
      "match": "(?i)\\b(ClearTextureFilters|SetCameraClearColor|SetCameraProjection|ApplyTorqueImpulse|CountMeshTriangles|EntityGravityScale|GetGraphicsQuality|SetAngularVelocity|SetCollisionRadius|SetEntityDirection|SetEntityShininess|SetTexturePosition|SetTextureRotation|CollisionTriangle|GetEntityDistance|SetCameraFogColor|SetCameraFogRange|SetCameraPosition|SetCameraRotation|SetCameraViewport|SetEntityPosition|SetEntityRotation|SetLightDirection|AngularVelocityX|AngularVelocityY|AngularVelocityZ|CollisionSurface|CreateFixedJoint|CreateHingeJoint|ImageRectCollide|ImageRectOverlap|SetCollisionType|SetEntityTexture|SetLightPosition|AcceptTCPStream|ClearCollisions|CollisionEntity|CountCollisions|CountGfxDrivers|CountGfxModes3D|CreateBallJoint|CreateTCPServer|CreateUDPStream|EntityNormalMap|EntityShininess|GetBrushTexture|GetSurfaceBrush|GfxDriverCaps3D|GfxMode3DExists|GraphicsQuality|LightConeAngles|LoadAnimTexture|MeshesIntersect|PositionTexture|SetAmbientLight|SetCollisionBox|SetEntityParent|SetTextureScale|TranslateEntity|VertexTexCoords|ApplyImpulseAt|BrushShininess|CameraClsColor|CameraFogColor|CameraFogRange|CameraProjMode|CameraViewport|ChannelPlaying|CloseTCPServer|CloseTCPStream|CloseUDPStream|CountTriangles|CreateCylinder|CreateListener|EntityAutoFade|EntityCollided|EntityDistance|EntityFriction|EntityPickMode|EntityTouching|ExtractAnimSeq|GetEntityBrush|GetEntityPitch|GraphicsBuffer|GraphicsHeight|PhysicsGravity|PhysicsRayCast|PickedTriangle|PositionEntity|SetCameraRange|SetEntityAlpha|SetEntityBlend|SetEntityColor|SetEntityScale|SetWindowTitle|SpriteViewMode|SystemProperty|TerrainShading|TriangleVertex|WritePixelFast|AlignToVector|AutoMidHandle|CameraClsMode|CameraFogMode|CameraProject|ChannelVolume|CollisionTime|ContactEntity|CopyPixelFast|CountAnimSeqs|CountChildren|CountContacts|CountGfxModes|CountSurfaces|CountVertices|CreateSurface|CreateTerrain|CreateTexture|DrawBlockRect|DrawImageRect|EntityDamping|EntityPhysics|EntityTexture|EntityVisible|GetEntityName|GetEntityRoll|GetEntityType|GetMatElement|GfxDriverName|GfxModeExists|GfxModeHeight|GraphicsDepth|GraphicsWidth|ImagesCollide|ImagesOverlap|LoadAnimImage|LoadAnimModel|ModifyTerrain|OpenTCPStream|PickedSurface|ReadPixelFast|ResumeChannel|RotateTexture|SetCameraZoom|SetClearColor|SetEntityName|SetFullscreen|SetLightColor|SetLightRange|TCPStreamPort|TerrainDetail|TerrainHeight|TextureBuffer|TextureCoords|TextureFilter|TextureHeight|UDPStreamPort|UpdateNormals|UpdatePhysics|AmbientLight|ApplyImpulse|BrushTexture|BufferHeight|CameraLookAt|CaptureMouse|CaptureWorld|ChannelPitch|ClearSurface|CountHostIPs|CreateCamera|CreateMirror|CreateSphere|CreateSprite|EntityBounce|EntityHidden|EntityInView|EntityParent|EntityRadius|GetEntityYaw|GfxModeDepth|GfxModeWidth|HandleSprite|ImageXHandle|ImageYHandle|IsFullscreen|LightShadows|LoadAnimMesh|LockRotation|PaintSurface|PauseChannel|PickedEntity|PositionMesh|RectsOverlap|RotateEntity|RotateSprite|RuntimeError|ScaleTexture|SetCameraFog|SetGfxDriver|SetLightCone|StringHeight|TextureBlend|TextureWidth|TrisRendered|UnlockBuffer|VertexCoords|VertexNormal|AddTriangle|ApplyTorque|AvailVidMem|BufferWidth|CameraRange|ClearScreen|CollisionNX|CollisionNY|CollisionNZ|CommandLine|CreateBrush|CreateImage|CreateLight|CreatePivot|CreatePlane|CreateTimer|CurrentDate|CurrentTime|EndGraphics|EntityAlpha|EntityBlend|EntityClass|EntityColor|EntityOrder|EntityPitch|FindSurface|FormatFloat|FreeTexture|FrontBuffer|HandleImage|HidePointer|ImageBuffer|ImageFrames|ImageHeight|Load3DSound|LoadTerrain|LoadTexture|MouseXSpeed|MouseYSpeed|MouseZSpeed|PaintEntity|PlayCDTrack|PointEntity|RenderWorld|ResetEntity|ResizeImage|RotateImage|ScaleEntity|ScaleSprite|SetAnimTime|SetCubeFace|SetCubeMode|SetEntityFX|SetPickMode|SetVelocity|ShowPointer|SoundVolume|StopChannel|StringWidth|TCPStreamIP|TCPTimeouts|TFormFilter|TFormNormal|TFormVector|TerrainSize|TextureName|TotalVidMem|UDPStreamIP|UDPTimeouts|UpdateWorld|VectorPitch|VertexAlpha|VertexColor|VertexGreen|WriteString|AddAnimSeq|AnimLength|ApplyForce|BackBuffer|BrushAlpha|BrushBlend|BrushColor|CameraPick|CameraZoom|ChannelPan|ClearWorld|CollisionX|CollisionY|CollisionZ|Collisions|ColorGreen|CopyEntity|CopyStream|CreateBank|CreateCone|CreateCube|CreateMesh|CurrentDir|DeleteFile|DeltaPitch|EntityMass|EntityName|EntityPick|EntityRoll|EntityType|FlushMouse|FontHeight|FreeEntity|GetEntityX|GetEntityY|GetEntityZ|GetSurface|Graphics3D|HWMultiTex|HWTexUnits|HideEntity|ImageWidth|LightColor|LightRange|LoadBuffer|LoadSprite|LockBuffer|MeshHeight|MoveEntity|NameEntity|PickedTime|PostEffect|ProjectedX|ProjectedY|ProjectedZ|ReadString|RecvUDPMsg|ResizeBank|RotateMesh|SaveBuffer|ScaleImage|SendUDPMsg|SetAnimKey|ShowEntity|SoundPitch|TFormImage|TFormPoint|TurnEntity|UDPMsgPort|VertexBlue|Windowed3D|WriteBytes|WriteFloat|WritePixel|WriteShort|AddVertex|Animating|AntiAlias|ChangeDir|CloseFile|ColorBlue|CopyImage|CopyModel|CopyPixel|CountJoys|CreateDir|DeleteDir|DrawBlock|DrawImage|DrawPixel|EmitSound|EntityBox|EntityYaw|FindChild|FlushKeys|FontWidth|FreeBrush|FreeImage|FreeJoint|FreeSound|FreeTimer|GetParent|GrabImage|LightMesh|LoadBrush|LoadImage|LoadModel|LoadSound|LoopSound|MaskImage|MeshDepth|MeshWidth|MidHandle|MilliSecs|MouseDown|MoveMouse|PaintMesh|PeekFloat|PeekShort|PlayMusic|PlaySound|PokeFloat|PokeShort|ReadAvail|ReadBytes|ReadFloat|ReadPixel|ReadShort|SaveImage|ScaleMesh|SetBuffer|TileBlock|TileImage|VectorYaw|VelocityX|VelocityY|VelocityZ|VertexRed|WaitMouse|WaitTimer|WireFrame|WriteByte|WriteFile|WriteLine|AnimTime|AppTitle|BankSize|CloseDir|ClsColor|ColorRed|CopyBank|CopyFile|CopyMesh|CopyRect|DebugLog|DeltaYaw|DottedIP|DrawLine|DrawOval|DrawRect|DrawText|EntityFX|ExecFile|FileSize|FileType|FlipMesh|FlushJoy|FreeBank|FreeFont|GetChild|GetColor|GetMouse|Graphics|JoyPitch|LinePick|LoadFont|LoadMesh|MouseHit|NextFile|OpenFile|PeekByte|PickedNX|PickedNY|PickedNZ|PokeByte|ReadByte|ReadFile|ReadLine|ScanLine|SeekFile|SetColor|SoundPan|TFormedX|TFormedY|TFormedZ|TerrainX|TerrainY|TerrainZ|UDPMsgIP|VertexNX|VertexNY|VertexNZ|Viewport|WriteInt|AddMesh|AnimSeq|Animate|BrushFX|CallDLL|EntityX|EntityY|EntityZ|FilePos|FitMesh|JoyDown|JoyRoll|JoyType|JoyUDir|JoyVDir|JoyXDir|JoyYDir|JoyZDir|KeyDown|PeekInt|PickedX|PickedY|PickedZ|PokeInt|ReadDir|ReadInt|Replace|RndSeed|SeedRnd|SetFont|VertexU|VertexV|VertexW|VertexX|VertexY|VertexZ|WaitJoy|WaitKey|Dither|GetEnv|GetJoy|GetKey|HostIP|JoyHat|JoyHit|JoyYaw|KeyHit|Locate|LookAt|MouseX|MouseY|MouseZ|Origin|SetEnv|String|TypeOf|ATan2|Clamp|Color|Delay|Floor|Input|Instr|Log10|Lower|Print|Right|Upper|VWait|Write|ACos|ASin|ATan|Ceil|Flip|JoyU|JoyV|JoyX|JoyY|JoyZ|LSet|Left|Lerp|Line|Oval|Plot|RSet|Rand|Rect|Text|Trim|Asc|Bin|Chr|Cls|Cos|Eof|Exp|Hex|Len|Log|Max|Mid|Min|Rnd|Sin|Sqr|Tan)\\b"
    },
    {
      "name": "constant.other.neptune",
      "match": "\\b[A-Z][A-Z0-9_]*_[A-Z0-9_]+\\b"
    },
    {
      "name": "keyword.operator.neptune",
      "match": "\\+=|-=|\\*=|/=|<>|<=|>=|[-+*/^=<>\\]"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.neptune",
          "match": ";.*$"
        },
        {
          "name": "comment.line.quote.neptune",
          "match": "'.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.neptune",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.neptune",
              "match": "\"\"|\\{\\{|\\}\\}"
            },
            {
              "name": "meta.embedded.neptune",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.neptune",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.neptune",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.neptune",
          "match": "\\$[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.binary.neptune",
          "match": "%[01]+\\b"
        },
        {
          "name": "constant.numeric.neptune",
          "match": "\\b[0-9]+(\\.[0-9]*)?([eE][-+]?[0-9]+)?\\b|\\.[0-9]+\\b"
        }
      ]
    }
  }
}