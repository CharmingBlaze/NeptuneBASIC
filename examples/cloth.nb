; Cloth and ropes: a flag in the wind, a curtain a ball pushes through,
; a cape on a walking figure and a lantern swinging on a rope.
; Run from the repository root: neptune run examples/cloth.nb
; Space: drop a sheet onto the rock   W: wind stronger / calmer   Esc: quit

Graphics3D 1280, 720
AppTitle "NeptuneBASIC - Cloth and ropes"

cam = CreateCamera()
PositionEntity cam, 0, 4, -11
LookAt cam, 0, 2.2, 0
CameraClsColor cam, 150, 180, 210
sun = CreateLight(1)
RotateEntity sun, 45, 30, 0
LightShadows sun, True
AmbientLight 110, 110, 120

ground = CreateCube()
ScaleEntity ground, 12, 0.1, 8
PositionEntity ground, 0, -0.1, 0
EntityColor ground, 120, 140, 100

; a stripy texture for the cloths
Function Stripes(r1, g1, b1, r2, g2, b2)
    t = CreateTexture(64, 64)
    SetBuffer TextureBuffer(t)
    For y = 0 To 63 Step 16
        Color r1, g1, b1 : Rect 0, y, 64, 8
        Color r2, g2, b2 : Rect 0, y + 8, 64, 8
    Next
    SetBuffer BackBuffer()
    Return t
End Function

; ---- a flag on a pole, flapping in the wind
pole = CreateCylinder(8)
ScaleEntity pole, 0.06, 2.5, 0.06
PositionEntity pole, -5, 2.5, 2
; the cloth hangs from its top edge (1.4 long): turned on its side, that edge
; runs up the pole and the flag (2.2 long) flies out from it
flag = CreateCloth(1.4, 2.2, 12, 18)
PositionEntity flag, -4.94, 4.25, 2
RotateEntity flag, 0, 0, -90
EntityTexture flag, Stripes(200, 40, 40, 240, 240, 240)
; the edge next to the pole (the cloth's top edge, turned) is held
ClothPinEdge flag, 0
ClothWind flag, 3
SetWindDirection 1, 0.3
SetWindStrength 0.25

; ---- a curtain, with a ball that swings through it
rail = CreateCube()
ScaleEntity rail, 1.6, 0.05, 0.05
PositionEntity rail, 0, 4.2, 1
curtain = CreateCloth(3, 3.6, 18, 20)
PositionEntity curtain, 0, 4.15, 1
EntityTexture curtain, Stripes(60, 90, 170, 90, 130, 210)
ClothPinEdge curtain, 0
ClothFloor curtain, 0
ClothWind curtain, 0.3
ball = CreateSphere(16)
ScaleEntity ball, 0.6, 0.6, 0.6
EntityColor ball, 230, 190, 60
EntityRadius ball, 0.6
ClothCollide curtain, ball

; ---- a rock to drop a sheet onto (Space)
rock = CreateSphere(16)
ScaleEntity rock, 0.8, 0.8, 0.8
PositionEntity rock, -2.4, 0.6, -2.2
EntityColor rock, 140, 130, 120

; ---- a figure walking in a circle with a cape
body = CreateCylinder(12)
ScaleEntity body, 0.35, 0.9, 0.35
EntityColor body, 70, 70, 80
head = CreateSphere(12, body)
PositionEntity head, 0, 1.4, 0
ScaleEntity head, 0.8, 0.45, 0.8
cape = CreateCloth(0.9, 1.5, 8, 12)
EntityColor cape, 150, 30, 40
ClothFloor cape, 0
; the cape starts at the figure's shoulders and its top edge is held by the figure
PositionEntity cape, 3.5, 1.75, -0.4
PositionEntity body, 3.5, 0.9, 0
ClothPinEdge cape, 0, body
ClothCollide cape, body, 0.45

; ---- a lantern on a rope from a beam
beam = CreateCube()
ScaleEntity beam, 1, 0.1, 0.1
PositionEntity beam, 4.5, 4.6, 2.5
rope = CreateRope(4.5, 4.5, 2.5, 4.5, 2.6, 2.5, 16, 0.05)
EntityColor rope, 120, 90, 60
ClothPin rope, 0                   ; the top end is held
lantern = CreateSphere(12)
ScaleEntity lantern, 0.25, 0.32, 0.25
EntityColor lantern, 255, 220, 120
EntityEmissive lantern, 255, 190, 90, 1.5

windy = 1
sheet = 0
angle# = 0
frames = 0
While True
    frames = frames + 1
    If KeyHit(KEY_W)
        windy = 1 - windy
        If windy Then SetWindStrength 0.25 Else SetWindStrength 0.05
    EndIf
    If KeyHit(KEY_SPACE)
        ; a sheet dropped from above onto the ball
        If sheet Then FreeEntity sheet
        sheet = CreateCloth(2.4, 2.4, 16, 16)
        ; flat (turned so it hangs forwards), its middle over the rock
        PositionEntity sheet, EntityX(rock), 3, EntityZ(rock) - 1.2
        RotateEntity sheet, -90, 0, 0
        EntityColor sheet, 240, 240, 230
        ClothCollide sheet, rock, 0.82
        ClothFloor sheet, 0
    EndIf

    ; the ball swings to and fro through the curtain
    PositionEntity ball, Sin(frames * 0.8) * 1.2, 1.3, 1 + Cos(frames * 0.8) * 1.8
    ; the figure walks round
    angle = angle + 0.5
    PositionEntity body, 3.5 + Sin(angle) * 1.2, 0.9, Cos(angle) * 1.2 - 1
    RotateEntity body, 0, angle + 90, 0
    ; the lantern hangs at the end of the rope
    PositionEntity lantern, ClothPointX(rope, -1), ClothPointY(rope, -1) - 0.3, ClothPointZ(rope, -1)
    If frames = 30 Then ClothGravity rope, 3, -9.8, 0    ; a gust gives it a swing
    If frames = 60 Then ClothGravity rope, 0, -9.8, 0

    RenderWorld
    Color 20, 30, 40
    Text 12, 12, "Space: drop a sheet onto the rock   W: wind   Esc: quit"
    Flip
    If frames > 8 And KeyHit(KEY_ESCAPE) Then End
Wend
