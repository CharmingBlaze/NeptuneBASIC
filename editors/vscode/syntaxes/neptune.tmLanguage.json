{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NeptuneBASIC",
  "scopeName": "source.neptune",
  "fileTypes": [
    "nb",
    "bb"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "name": "keyword.control.neptune",
      "match": "(?i)\\b(end\\s+(if|function|type|select|try|method|enum)|else\\s+if)\\b"
    },
    {
      "name": "keyword.control.neptune",
      "match": "(?i)\\b(EndFunction|EndMethod|EndSelect|Continue|Function|Classic|Default|EndEnum|EndType|Forever|Include|Restore|Before|Delete|ElseIf|EndTry|Global|Import|Insert|Method|Repeat|Return|Select|Strict|After|Catch|Const|EndIf|Field|First|Gosub|Local|Throw|Until|While|Case|Data|Each|Else|Enum|Exit|Goto|Last|Next|Read|Step|Stop|Then|Type|Wend|Dim|End|For|New|Try|As|If|In|To)\\b"
    },
    {
      "name": "keyword.operator.word.neptune",
      "match": "(?i)\\b(AndAlso|OrElse|And|Mod|Not|Sar|Shl|Shr|Xor|Or)\\b"
    },
    {
      "name": "constant.language.neptune",
      "match": "(?i)\\b(False|Null|Self|True|Pi)\\b"
    },
    {
      "name": "storage.type.neptune",
      "match": "(?i)\\b(Boolean|Integer|Variant|Handle|Object|Single|String|Float|Bool|Abs|Any|Int|Sgn|Str)\\b"
    },
    {
      "name": "entity.name.label.neptune",
      "match": "^\\s*\\.[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "support.function.neptune",
      "match": "(?i)\\b(Body2DFixedRotation|ClearTextureFilters|CreateSliderJoint2D|SetCameraClearColor|SetCameraProjection|ApplyTorqueImpulse|Body2DGravityScale|CameraColorGrading|CountMeshTriangles|CreateFixedJoint2D|CreateHingeJoint2D|DirectInputEnabled|EntityGravityScale|EntityRoughnessMap|GetGraphicsQuality|SetAngularVelocity|SetCollisionRadius|SetEntityDirection|SetEntityShininess|SetTexturePosition|SetTextureRotation|CollisionTriangle|EnableDirectInput|EntityEmissiveMap|EntityMetallicMap|GetEntityDistance|SetCameraFogColor|SetCameraFogRange|SetCameraPosition|SetCameraRotation|SetCameraViewport|SetEntityPosition|SetEntityRotation|SetLightDirection|AngularVelocityX|AngularVelocityY|AngularVelocityZ|CollisionSurface|CreateFixedJoint|CreateHingeJoint|EmitterFadeColor|ImageRectCollide|ImageRectOverlap|LoadTextureAsync|Physics2DGravity|ScreenToWorld2DX|ScreenToWorld2DY|SetCollisionType|SetEntityTexture|SetLightPosition|WorldToScreen2DX|WorldToScreen2DY|AcceptTCPStream|CameraToTexture|ClearCollisions|CollisionEntity|CountCollisions|CountContacts2D|CountGfxDrivers|CountGfxModes3D|CreateBallJoint|CreateNetPlayer|CreateTCPServer|CreateUDPStream|DeleteNetPlayer|EmitterSoftness|EmitterVelocity|EntityHeightMap|EntityNormalMap|EntityRoughness|EntityShininess|GetBrushTexture|GetSurfaceBrush|GfxDriverCaps3D|GfxMode3DExists|GraphicsQuality|LightConeAngles|LoadAnimTexture|MeshesIntersect|PositionTexture|SetAmbientLight|SetCollisionBox|SetEntityParent|SetTextureScale|TranslateEntity|VertexDataValue|VertexTexCoords|ActiveTextures|ApplyImpulse2D|ApplyImpulseAt|Body2DFriction|Body2DTouching|BrushShininess|Camera2DEnable|CameraClsColor|CameraExposure|CameraFogColor|CameraFogRange|CameraProjMode|CameraViewport|ChannelPlaying|CloseTCPServer|CloseTCPStream|CloseUDPStream|CountTriangles|CreateCylinder|CreateListener|EmitterGravity|EntityAutoFade|EntityCollided|EntityDistance|EntityEmissive|EntityFriction|EntityLightmap|EntityMetallic|EntityPickMode|EntityTouching|ExtractAnimSeq|GetEnti