; Blitz3D language audit: each section prints a line; failures stop the run.
Print "1 hex/bin " + $FF + " " + %1010 + " " + Hex$(255) + " " + Bin$(5)
Print "2 strings " + Mid$("Hello", 2) + "|" + Mid("Hello", 2, 2) + "|" + Instr("abcabc", "c", 4) + "|" + Replace$("aXbX", "X", "-")
Print "3 lset " + "[" + LSet$("ab", 4) + "][" + RSet$("ab", 4) + "] " + String$("ab", 3) + " " + Chr$(65) + Asc("a")
Print "4 maths " + Sgn(-2.5) + " " + Abs(-3) + " " + Floor(2.7) + " " + Ceil(2.1) + " " + (7 / 2) + " " + (2 ^ 3) + " " + (5 Xor 3)
Print "5 conv " + Int("3.7") + " " + Int(3.5) + " " + Int(2.5) + " " + Float(3) / 2 + " " + Str(1.5)
Print "6 compare " + ("abc" < "abd") + " " + (Not 1 = 2) + " " + (True + 1)

Dim grid(3, 3)
grid(2, 2) = 9
Dim grid(3, 3)
Print "7 redim " + grid(2, 2)

Type Ship
    Field name$
    Field hp
    Field cargo[3]
    Field nxt.Ship
End Type

Dim fleet.Ship(2)
For i = 0 To 2
    fleet(i) = New Ship
    fleet(i)\name = "S" + i
    fleet(i)\hp = i * 10
    fleet(i)\cargo[1] = i
Next
fleet(0)\nxt = fleet(1)
Print "8 typed array " + fleet(2)\name + " " + fleet(0)\nxt\name + " " + fleet(1)\cargo[1]

Function FindShip.Ship(n$)
    For s.Ship = Each Ship
        If s\name = n Then Return s
    Next
    Return Null
End Function
Print "9 type fn " + FindShip("S1")\hp + " " + (FindShip("zz") = Null)

h = Handle(fleet(2))
o.Ship = Object.Ship(h)
Print "10 handle " + o\name
f.Ship = First Ship
l.Ship = Last Ship
Insert l Before f
Print "11 insert " + (First Ship)\name + " " + (After First Ship)\name
Delete First Ship
n = 0
For s.Ship = Each Ship
    n = n + 1
Next
Print "12 delete " + n

Function Fact(n)
    If n <= 1 Then Return 1
    Return n * Fact(n - 1)
End Function
Print "13 recursion " + Fact(10)

Global counter
Function Bump()
    counter = counter + 1
End Function
Bump() : Bump
Print "14 global " + counter

Restore stuff
Read a, b#, c$
Print "15 data " + a + " " + b + " " + c

i = 0
Repeat
    i = i + 1
    If i = 5 Then Exit
Forever
Print "16 forever exit " + i

Select 3
    Case 1, 2
        Print "17 select wrong"
    Case 3
        Print "17 select ok"
    Default
        Print "17 select default"
End Select

x = 0
Gosub addten
Print "18 gosub " + x
Goto skip
Print "never"
.skip
Print "19 goto ok"

Local v[4]
v[4] = 7
Print "20 local array " + v[4]

Const K = 2 * 3 + 1
Print "21 const " + K

acc$ = "a"
For i = 1 To 3
    acc = acc + i
Next
Print "22 str concat " + acc
Print "23 float print " + 1.0 + " " + (1 / 3.0)
Print "24 neg mod " + (-7 Mod 3) + " shr " + (-8 Shr 1) + " sar " + (-8 Sar 1)
Print "25 rand " + (Rand(5) >= 1) + " " + (Rnd(1) < 1)
Print "26 nested " + Len(Upper$(Trim$("  ab  ")))
Print "27 atan2 " + Int(ATan2(1, 1))
End

.addten
x = x + 10
Return

.stuff
Data -5, 2.5, "text"
