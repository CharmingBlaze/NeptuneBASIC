; Rendering: terrain with and without level of detail, particles, sprites,
; and 2D drawing.
Include "bench.nb"
Graphics3D 1280, 720
cam = BenchScene(0, 60, -40, 0, 20, 300)

; a 1024 x 1024 terrain (2 million triangles at full detail)
land = CreateTerrain(1024)
ScaleEntity land, 2, 120, 2
PositionEntity land, -1024, 0, -100
For x = 0 To 1024
    For z = 0 To 1024
        ModifyTerrain land, x, z, 0.4 + 0.25 * Sin(x * 1.3) * Cos(z * 1.1) + 0.1 * Sin((x + z) * 4)
    Next
Next
Report "rendering", "1024x1024 terrain, full detail", MeasureFps(150, 10), "fps"
TerrainDetail land, 60000
Report "rendering", "1024x1024 terrain, TerrainDetail 60000", MeasureFps(150, 10), "fps"
FreeEntity land

PositionEntity cam, 0, 20, -60
LookAt cam, 0, 10, 0
blob = CreateTexture(32, 32, 1 + 2)
SetBuffer TextureBuffer(blob)
For y = 0 To 31
    For x = 0 To 31
        d# = Sqr((x - 16) ^ 2 + (y - 16) ^ 2) / 16.0
        a = 255 * (1 - d) : If a < 0 Then a = 0
        WritePixel x, y, (a Shl 24) Or $FFFFFF
    Next
Next
SetBuffer BackBuffer()

; particles: 20 emitters, 1000 particles each
Dim emitters(19)
For i = 0 To 19
    e = CreateEmitter(blob)
    PositionEntity e, (i Mod 5) * 12 - 24, 0, (i / 5) * 12
    EmitterRate e, 400
    EmitterMax e, 1000
    EmitterLife e, 2, 2.5
    EmitterVelocity e, 0, 6, 0, 2
    EmitterColor e, 255, 200, 120, 255
    emitters(i) = e
Next
Report "rendering", "20000 particles", MeasureFps(200, 120), "fps"
For i = 0 To 19
    FreeEntity emitters(i)
Next

; sprites always facing the camera
Dim sprites(4999)
For i = 0 To 4999
    s = CreateSprite()
    EntityTexture s, blob
    PositionEntity s, Rnd(-40, 40), Rnd(0, 30), Rnd(0, 80)
    sprites(i) = s
Next
Report "rendering", "5000 camera-facing sprites, 1 m, overlapping", MeasureFps(200, 10), "fps"
; the same sprites small, so drawing them is not limited by overlap
For i = 0 To 4999
    ScaleSprite sprites(i), 0.2, 0.2
Next
Report "rendering", "5000 camera-facing sprites, 0.2 m", MeasureFps(200, 10), "fps"
For i = 0 To 4999
    FreeEntity sprites(i)
Next

; 2D on top of the 3D view
img = CreateImage(32, 32)
SetBuffer ImageBuffer(img)
Color 255, 180, 60
Oval 0, 0, 32, 32
SetBuffer BackBuffer()
Data 1000, 5000, 10000
For stage = 1 To 3
    Read n
    t = MilliSecs()
    For f = 1 To 200
        RenderWorld
        For i = 1 To n
            DrawImage img, (i * 37) Mod 1248, (i * 53 + f) Mod 688
        Next
        Flip
    Next
    Report "rendering", $"{n} DrawImage per frame", 200000.0 / Max(1, MilliSecs() - t), "fps"
Next
t = MilliSecs()
For f = 1 To 200
    RenderWorld
    For i = 0 To 999
        Text (i * 97) Mod 1200, (i * 13) Mod 700, "Hello"
    Next
    Flip
Next
Report "rendering", "1000 Text calls per frame", 200000.0 / Max(1, MilliSecs() - t), "fps"
End
