  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "name": "keyword.control.neptune",
      "match": "(?i)\\b(end\\s+(if|function|type|select|try|method|enum)|else\\s+if)\\b"
    },
    {
      "name": "keyword.control.neptune",
      "match": "(?i)\\b(EndFunction|EndMethod|EndSelect|Continue|Function|Classic|Default|EndEnum|EndType|Forever|Include|Restore|Before|Delete|ElseIf|EndTry|Global|Import|Insert|Method|Repeat|Return|Select|Strict|After|Catch|Const|EndIf|Field|First|Gosub|Local|Throw|Until|While|Case|Data|Each|Else|Enum|Exit|Goto|Last|Next|Read|Step|Stop|Then|Type|Wend|Dim|End|For|New|Try|As|If|In|To)\\b"
    },
    {
      "name": "keyword.operator.word.neptune",
      "match": "(?i)\\b(AndAlso|OrElse|And|Mod|Not|Sar|Shl|Shr|Xor|Or)\\b"
    },
    {
      "name": "constant.language.neptune",
      "match": "(?i)\\b(False|Null|Self|True|Pi)\\b"
    },
    {
      "name": "storage.type.neptune",
      "match": "(?i)\\b(Boolean|Integer|Variant|Handle|Object|Single|String|Float|Bool|Abs|Any|Int|Sgn|Str)\\b"
