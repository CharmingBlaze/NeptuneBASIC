X|TFormedY|TFormedZ|TerrainX|TerrainY|TerrainZ|UDPMsgIP|UIButton|UISlider|VertexNX|VertexNY|VertexNZ|Viewport|WriteInt|AddInts|AddMesh|AnimSeq|Animate|Average|Body2DX|Body2DY|BrushFX|CallDLL|EntityX|EntityY|EntityZ|FilePos|FitMesh|GetTile|JoyDown|JoyRoll|JoyType|JoyUDir|JoyVDir|JoyWait|JoyXDir|JoyYDir|JoyZDir|KeyDown|PeekInt|PickedX|PickedY|PickedZ|PokeInt|ReadDir|ReadInt|Replace|RndSeed|SeedRnd|SetFont|SetTile|UIHover|UILabel|UIPanel|UITheme|VertexU|VertexV|VertexW|VertexX|VertexY|VertexZ|WBuffer|WaitJoy|WaitKey|Dither|GetEnv|GetJoy|GetKey|HostIP|JoyHat|JoyHit|JoyYaw|KeyHit|Locate|LookAt|MouseX|MouseY|MouseZ|Origin|SetEnv|SkyBox|String|TileAt|TypeOf|ATan2|Clamp|Color|Delay|Floor|Greet|Input|Instr|Log10|Lower|Print|Right|Upper|VWait|Write|ACos|ASin|ATan|Ceil|Flip|JoyU|JoyV|JoyX|JoyY|JoyZ|LSet|Left|Lerp|Line|Oval|Plot|RSet|Rand|Rect|Text|Trim|Asc|Bin|Chr|Cls|Cos|Eof|Exp|Fib|Hex|Len|Log|Max|Mid|Min|Rnd|Sin|Sqr|Tan)\\b"
    },
    {
      "name": "constant.other.neptune",
      "match": "\\b[A-Z][A-Z0-9_]*_[A-Z0-9_]+\\b"
    },
    {
      "name": "keyword.operator.neptune",
      "match": "\\+=|-=|\\*=|/=|<>|<=|>=|[-+*/^=<>\\]"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.neptune",
          "match": ";.*$"
        },
        {
          "name": "comment.line.quote.neptune",
          "match": "'.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.neptune",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.neptune",
              "match": "\"\"|\\{\\{|\\}\\}"
            },
            {
              "name": "meta.embedded.neptune",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.neptune",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.neptune",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.neptune",
          "match": "\\$[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.binary.neptune",
          "match": "%[01]+\\b"
        },
        {
          "name": "constant.numeric.neptune",
          "match": "\\b[0-9]+(\\.[0-9]*)?([eE][-+]?[0-9]+)?\\b|\\.[0-9]+\\b"
        }
      ]
    }
  }
}